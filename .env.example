# Your Anthropic API key. Powers analyses run by the owner (see OWNER_PASSPHRASE).
# Visitors supply their own key in the app and never touch this one.
ANTHROPIC_API_KEY=sk-ant-...

# Unlocks ANTHROPIC_API_KEY for whoever knows it. Must be at least 24 characters
# — anything shorter is treated as unset, because a per-instance rate limiter
# cannot protect a billing account from distributed guessing.
#
# Leave this UNSET and the server key becomes unreachable: the deployment is
# then pure bring-your-own-key and cannot spend your money at all.
#   openssl rand -base64 32
OWNER_PASSPHRASE=

# Optional. Comma-separated origins allowed to call the API from a browser.
# Your Vercel deployment URL is always allowed. Unset means no origin filtering.
ALLOWED_ORIGINS=https://reg-ready.vercel.app

# Optional. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5
